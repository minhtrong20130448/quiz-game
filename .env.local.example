# Sao chép file này thành ".env.local" (không commit lên Git) rồi điền giá trị thật.

# Supabase → Project Settings → Data API → Project URL (dạng https://<project-id>.supabase.co)
SUPABASE_URL=

# Supabase → Project Settings → API Keys → secret key (dạng sb_secret_...)
# ⚠️ Có toàn quyền đọc/ghi DB, bỏ qua RLS — chỉ dùng ở server (API routes), không lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Mật khẩu tự đặt để bảo vệ trang /admin và các API /api/admin/*
ADMIN_PASSWORD=

# Thông tin tài khoản ngân hàng nhận tiền, dùng để tạo QR VietQR (xem Plan mục 4).
# Mã ngân hàng/BIN — tra tại https://api.vietqr.io/v2/banks (vd Vietcombank = 970436)
BANK_BIN=
# Số tài khoản ngân hàng nhận tiền
BANK_ACCOUNT_NUMBER=
# Tên chủ tài khoản (KHÔNG dấu, đúng như trên sổ ngân hàng) — sẽ hiển thị công khai trên QR
BANK_ACCOUNT_NAME=

# SePay (sepay.vn) → Cấu hình → Webhooks → API Key, dùng để xác thực webhook
# POST /api/webhooks/sepay (chống người lạ giả mạo báo "đã thanh toán").
SEPAY_WEBHOOK_API_KEY=
